<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        Saída em JSON estruturado (não o padrão texto do Spring Boot) -- mesma motivação
        de tracing_subscriber .json() no orquestrador Rust: os campos ficam preservados
        como chaves separadas em vez de virarem parte de uma linha de texto que um
        coletor externo (Promtail/Datadog Agent) precisaria fazer regex pra recuperar.

        "domain" e "service" são constantes (não mudam por linha) -- é o que permite
        filtrar "só logs do loja-inventory-service" num backend de log externo, mesmo
        quando esse binário roda ao lado de outros serviços Java do monorepo. Ver
        InventoryCommandListener: correlationId vai pro MDC, então aparece automaticamente
        em toda linha de log emitida durante o processamento de uma mensagem, sem precisar
        passá-lo manualmente em cada log.info(...).
    -->
    <appender name="STDOUT_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"loja-inventory-service","domain":"loja"}</customFields>
            <includeMdcKeyName>correlationId</includeMdcKeyName>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT_JSON"/>
    </root>
</configuration>
